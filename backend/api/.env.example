# BioWallet Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database ────────────────────────────────────
# WARNING: Change the password before deploying to production!
DATABASE_URL=postgresql://biowallet:CHANGE_ME_TO_A_SECURE_PASSWORD@localhost:5432/biowallet
POSTGRES_USER=biowallet
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
POSTGRES_DB=biowallet

# ─── Authentication ──────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string

# ─── CORS ────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Admin ───────────────────────────────────────
ADMIN_API_KEY=change-me-to-a-secure-admin-key

# ─── Ethereum ────────────────────────────────────
ETHEREUM_RPC_URL=https://rpc.ankr.com/eth_sepolia
ETHEREUM_NETWORK=sepolia
