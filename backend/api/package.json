{
  "name": "api",
  "version": "3.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema ../db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../db/schema.prisma",
    "prisma:studio": "prisma studio --schema ../db/schema.prisma"
  },
  "prisma": {
    "schema": "../db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ethers": "6.16.0",
    "express": "^5.0.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.19",
    "@types/uuid": "^9.0.0",
    "prisma": "6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
