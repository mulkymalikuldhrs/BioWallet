// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  walletAddress   String           @unique
  publicKey       String
  email           String?          @unique
  deviceId        String?          @unique
  biometricType   BiometricType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transactions    Transaction[]
  referralCode    String?          @unique
  referredById    String?
  referrer        User?            @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]           @relation("UserReferrals")
  referralRewards ReferralReward[]
  isPremium       Boolean          @default(false)
  lastLogin       DateTime?

  @@index([email])
}

model Transaction {
  id             String            @id @default(uuid())
  txHash         String            @unique
  type           TransactionType
  token          String            @default("ETH")
  amount         Decimal           @db.Decimal(65, 18)
  fee            Decimal           @db.Decimal(65, 18)
  status         TransactionStatus @default(PENDING)
  fromAddress    String
  toAddress      String
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  blockNumber    Int?
  blockTimestamp DateTime?
  network        String            @default("sepolia")

  @@index([userId])
  @@index([fromAddress])
  @@index([toAddress])
  @@index([status])
  @@index([createdAt])
}

model ReferralReward {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  amount    Decimal      @db.Decimal(65, 18)
  status    RewardStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model AdminStats {
  id                Int      @id @default(autoincrement())
  totalUsers        Int      @default(0)
  totalTransactions Int      @default(0)
  totalVolume       Decimal  @default(0) @db.Decimal(65, 18)
  totalFees         Decimal  @default(0) @db.Decimal(65, 18)
  date              DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date])
}

enum BiometricType {
  FINGERPRINT
  FACE
  IRIS
}

enum TransactionType {
  SEND
  RECEIVE
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum RewardStatus {
  PENDING
  PAID
  FAILED
}
