# ═══════════════════════════════════════════════════════════════════════
# BioWallet Backend — Environment Variables
# Copy this file to .env and fill in the values before running the server.
# ═══════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://biowallet:CHANGE_ME_STRONG_PASSWORD@localhost:5432/biowallet

# ─── Authentication ────────────────────────────────────────────────────
# JWT secret — MUST be a long, random, cryptographically secure string.
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Admin API key — Required for admin endpoints.
# If not set, admin routes will return 503 (Service Unavailable).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_HEX_STRING

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In development, defaults to http://localhost:3000 if not set.
# In production, set to your actual frontend domain(s).
# Example: https://biowallet.app,https://admin.biowallet.app
CORS_ORIGIN=http://localhost:3000

# ─── Ethereum / Blockchain ─────────────────────────────────────────────
# RPC URL for Ethereum network (Sepolia testnet by default)
ETHEREUM_RPC_URL=https://rpc.ankr.com/eth_sepolia
# Network name (used for display/records)
ETHEREUM_NETWORK=sepolia
