# BioWallet — Root Environment Variables
# Copy this file to .env and fill in your values
#
# This file provides defaults for docker-compose.
# Service-specific envs are loaded from their own .env files.

# ─── PostgreSQL (used by docker-compose) ─────────
POSTGRES_USER=biowallet
POSTGRES_PASSWORD=biowallet
POSTGRES_DB=biowallet

# ─── Backend ─────────────────────────────────────
# See backend/api/.env.example for full list
DATABASE_URL=postgresql://biowallet:biowallet@postgres:5432/biowallet
JWT_SECRET=change-me-to-a-secure-random-string
CORS_ORIGIN=http://localhost:3000
ADMIN_API_KEY=change-me-to-a-secure-admin-key
ETHEREUM_RPC_URL=https://rpc.ankr.com/eth_sepolia
ETHEREUM_NETWORK=sepolia

# ─── Web App ─────────────────────────────────────
# See apps/web/.env.example for full list
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_RPC_URL=https://rpc.ankr.com/eth_sepolia
